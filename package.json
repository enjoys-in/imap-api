{
	"name": "@enjoys/imap-api",
	"version": "1.0.0",
	"scripts": {
		"build": "nest build",
		"ready": "npm install",
		"start": "node ./build/main.js",
		"dev": "nest start --watch",
		"mig:create": "typeorm migration:create ./src/factory/migrations/%npm_config_name%",
		"mig:run": "npx typeorm-ts-node-esm migration:generate ./src/factory/migrations/%npm_config_name% -d ./src/app/config/Datasource.ts",
		"mig:revert": "typeorm migration:revert -- -d ./src/app/config/Datasource.ts",
		"entity:create": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm entity:create -n",
		"migrate:generate": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm migration:generate -n",
		"migrate:run": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm migration:run",
		"migrate:revert": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm migration:revert",
		"schema:drop": "./node_modules/.bin/ts-node ./node_modules/.bin/typeorm schema:drop",
		"watch": "ts-node-dev --respawn -r tsconfig-paths/register  --transpile-only --ignore-watch node_modules src/main.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write . --ignore build ",
		"format": "biome format .",
		"format:fix": "biome check --fix --unsafe"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": ["biome check --write", "biome format --write"]
	},
	"author": "Mullayam",
	"license": "ISC",
	"dependencies": {
		"@biomejs/biome": "^1.9.4",
		"@enjoys/exception": "^1.1.2",
		"@nestjs/cli": "^11.0.16",
		"@swc/cli": "^0.7.10",
		"@swc/core": "^1.15.13",
		"@swc/helpers": "^0.5.19",
		"@types/glob": "^8.1.0",
		"@types/imapflow": "^1.0.189",
		"@types/mailparser": "^3.4.6",
		"@types/path-to-regexp": "^1.7.0",
		"axios": "^1.13.5",
		"bcrypt": "^5.1.1",
		"bcryptjs": "^3.0.3",
		"body-parser": "^1.20.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"colorette": "^2.0.20",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"crypto-js": "^4.2.0",
		"debug": "^4.4.3",
		"dotenv": "^16.6.1",
		"express": "^4.22.1",
		"express-fileupload": "^1.5.2",
		"express-rate-limit": "^7.5.1",
		"express-session": "^1.19.0",
		"express-validator": "^7.3.1",
		"glob": "^11.1.0",
		"googleapis": "^144.0.0",
		"helmet": "^8.1.0",
		"i": "^0.3.7",
		"imapflow": "^1.2.10",
		"jsonwebtoken": "^9.0.3",
		"mailparser": "^3.9.3",
		"mime-types": "^2.1.35",
		"moment": "^2.30.1",
		"morgan": "^1.10.1",
		"nodemailer": "^6.10.1",
		"nodemailer-express-handlebars": "^7.0.0",
		"path-to-regexp": "^8.3.0",
		"pg": "^8.19.0",
		"rate-limiter-flexible": "^5.0.5",
		"redis": "^4.7.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.3",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typeorm": "^0.3.28",
		"typescript": "^5.9.3",
		"validator": "^13.15.26",
		"winston": "^3.19.0"
	},
	"devDependencies": {
