# ==============================================================================
# AirSend IMAP API - Environment Configuration (.env.example)
# ==============================================================================

# Application Environment
APP_ENV="DEV"                         # DEV | STAGE | PROD | PRODUCTION
APP_PORT="9503"                        # Port backend server listens on
APP_DOMAIN="localhost"                 # e.g. airsend.in or localhost
API_VERSION="v1"                       # API prefix version: v1
API_KEY="your-secure-api-key-here"

# Domain Restrictions (* allows any domain, or comma-separated: company.com, mail.org)
ALLOWED_PRIMARY_DOMAINS="*"

# Security & Encryption Secrets
SALT=""
APP_SECRET="replace-with-a-secure-random-64-character-app-secret-string"
JWT_SECRET_TOKEN="replace-with-a-secure-random-jwt-signing-secret"
COOKIE_SECRET="replace-with-a-secure-cookie-signing-secret"
SESSION_SECRET="replace-with-a-secure-session-signing-secret"

# Clustered Node.js Process Execution
CLUSTERS="false"                       # true | false

# Email Template & Asset Paths
MAIL_TEMPLATE_PATH="./src/utils/resources/"

# ==============================================================================
# Multi-Engine Cache Configuration
# ==============================================================================
# CACHE_ENGINE: "memory" (In-Process TTL) | "redis" (Distributed) | "rocksdb" (Embedded Persistent)
CACHE_ENGINE="memory"
CACHE_HOST="redis://127.0.0.1:6379"
CACHE_PORT="6379"
ROCKSDB_PATH="./data/rocksdb"

# ==============================================================================
# Database Configuration (PostgreSQL / TypeORM)
# ==============================================================================
DB_DIALECT="postgres"
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="airmail-imap"
DB_USER="postgres"
DB_PASS="postgres_password"
# Optional full connection URI (overrides individual DB_* fields above if set):
# DATABASE_URL="postgresql://user:pass@127.0.0.1:5432/airmail-imap"

# ==============================================================================
# Default System Outbound SMTP Configuration (for notifications & system mail)
# ==============================================================================
SMTP_HOST="smtp.example.com"
SMTP_HOST_PORT=587
SMTP_TYPE="TLS"                        # TLS | SSL
SMTP_HOST_USER="noreply@example.com"
SMTP_HOST_PASS="your-smtp-password"
SMTP_SENDER_NAME="AirSend Mailer"

# Inbound Mail Server Relay Hook (Optional)
SMTP_SERVER_HOST="mail.example.com"
SMTP_SERVER_HOST_PORT=25

# ==============================================================================
# S3 / MinIO Object Storage Configuration (for attachment storage)
# ==============================================================================
ACCESS_KEY="your-storage-access-key"
SECRET_KEY="your-storage-secret-key"
REGION="us-east-1"
BUCKET_NAME="airsend-attachments"
